{%- comment -%}
  AI Search Section
  AI-powered search with Cloudflare Worker backend
  Features: Streaming responses, product cards, video embeds, document sources
  Includes graceful fallback to native search when AI is unavailable
{%- endcomment -%}

{{ 'ai-search.css' | asset_url | stylesheet_tag }}

<div 
  class="ai-search-wrapper" 
  id="ai-search-section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-worker-url="{{ section.settings.worker_url }}"
>
  <div class="container ai-search-content">
    {%- if section.settings.heading != blank -%}
      <h2 class="ai-search-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="ai-search-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- comment -%} Example Questions {%- endcomment -%}
    {%- if section.settings.show_examples -%}
      <div class="ai-search-examples">
        <span class="ai-search-examples-label">{{ section.settings.examples_label | default: 'Try asking:' }}</span>
        <div class="ai-search-examples-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'example' and block.settings.query != blank -%}
              <button 
                type="button" 
                class="ai-search-example-button" 
                data-query="{{ block.settings.query | escape }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | default: block.settings.query }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Search Form {%- endcomment -%}
    <div class="ai-search-form-wrapper">
      <form class="ai-search-form" action="{{ routes.search_url }}" method="get" role="search">
        <div class="ai-search-input-group">
          <label for="ai-search-input-{{ section.id }}" class="visually-hidden">
            {{ section.settings.input_label | default: 'Search' }}
          </label>
          <input
            type="text"
            id="ai-search-input-{{ section.id }}"
            name="q"
            class="ai-search-input"
            placeholder="{{ section.settings.placeholder | default: 'Ask a question about our products...' }}"
            autocomplete="off"
            aria-label="{{ section.settings.input_label | default: 'Search' }}"
          >
          <button type="submit" class="ai-search-submit" aria-label="Search">
            <span class="ai-search-submit-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </span>
            <span class="ai-search-submit-text">{{ section.settings.button_text | default: 'Ask AI' }}</span>
          </button>
        </div>
      </form>

      {%- comment -%} Status Messages {%- endcomment -%}
      <div class="ai-search-status" role="status" aria-live="polite"></div>

      {%- comment -%} Results Container {%- endcomment -%}
      <div class="ai-search-results" aria-live="polite"></div>
    </div>

    {%- comment -%} Fallback Notice {%- endcomment -%}
    <noscript>
      <div class="ai-search-noscript">
        <p>{{ section.settings.noscript_message | default: 'JavaScript is required for AI search. Use the form above for standard search.' }}</p>
      </div>
    </noscript>
  </div>
</div>

<style>
  #ai-search-section-{{ section.id }} {
    --ai-search-bg-start: {{ section.settings.bg_color_start | default: '#667eea' }};
    --ai-search-bg-end: {{ section.settings.bg_color_end | default: '#764ba2' }};
    --ai-search-text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --ai-search-input-bg: {{ section.settings.input_bg | default: '#ffffff' }};
    --ai-search-input-text: {{ section.settings.input_text | default: '#333333' }};
    --ai-search-button-bg: {{ section.settings.button_bg | default: '#667eea' }};
    --ai-search-button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --ai-search-answer-bg: {{ section.settings.answer_bg | default: '#f5f7ff' }};
    --ai-search-answer-text: {{ section.settings.answer_text | default: '#333333' }};
    --ai-search-heading-size: {{ section.settings.heading_size | default: 48 }}px;
    --ai-search-body-size: {{ section.settings.body_size | default: 16 }}px;
    --ai-search-border-radius: {{ section.settings.border_radius | default: 12 }}px;
  }

  #ai-search-section-{{ section.id }} {
    {%- case section.settings.background_style -%}
      {%- when 'gradient' -%}
        background: linear-gradient(135deg, var(--ai-search-bg-start) 0%, var(--ai-search-bg-end) 100%);
      {%- when 'radial' -%}
        background: radial-gradient(circle at center, var(--ai-search-bg-start) 0%, var(--ai-search-bg-end) 100%);
      {%- when 'solid' -%}
        background: var(--ai-search-bg-start);
    {%- endcase -%}
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
</style>

<script>
(function() {
  'use strict';
  
  const sectionId = '{{ section.id }}';
  const WORKER_URL = '{{ section.settings.worker_url | strip }}';
  const FALLBACK_TO_SEARCH = {{ section.settings.fallback_to_search | default: true }};
  const MAX_RETRIES = 2;
  
  // DOM Elements
  const section = document.getElementById('ai-search-section-' + sectionId);
  if (!section) return;
  
  const form = section.querySelector('.ai-search-form');
  const input = section.querySelector('.ai-search-input');
  const statusEl = section.querySelector('.ai-search-status');
  const resultsEl = section.querySelector('.ai-search-results');
  const exampleButtons = section.querySelectorAll('.ai-search-example-button');
  
  // State
  let isLoading = false;
  let conversationHistory = [];
  
  // Utility Functions
  function showLoading() {
    isLoading = true;
    statusEl.innerHTML = `
      <div class="ai-search-loading">
        <div class="ai-search-loading-spinner"></div>
        <span class="ai-search-loading-text">Thinking...</span>
      </div>
    `;
  }
  
  function hideLoading() {
    isLoading = false;
    statusEl.innerHTML = '';
  }
  
  function showError(message, showFallback = true) {
    hideLoading();
    let html = `
      <div class="ai-search-error">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
        <span>${escapeHtml(message)}</span>
      </div>
    `;
    
    if (showFallback && FALLBACK_TO_SEARCH) {
      const query = input.value.trim();
      html += `
        <div class="ai-search-fallback">
          <p>Try our standard search instead:</p>
          <a href="/search?q=${encodeURIComponent(query)}" class="ai-search-fallback-link">
            Search for "${escapeHtml(query)}"
          </a>
        </div>
      `;
    }
    
    statusEl.innerHTML = html;
  }
  
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
  
  function convertMarkdownToHtml(text) {
    if (!text) return '';
    let html = escapeHtml(text);
    
    // Bold
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    
    // Italic
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
    
    // Links
    html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="ai-search-product-link" target="_blank">$1</a>');
    
    // Line breaks
    html = html.replace(/\n/g, '<br>');
    
    return html;
  }
  
  // Main Search Function
  async function performSearch(query, retryCount = 0) {
    if (!query.trim()) return;
    if (isLoading) return;
    
    // Check if Worker URL is configured
    if (!WORKER_URL) {
      if (FALLBACK_TO_SEARCH) {
        window.location.href = '/search?q=' + encodeURIComponent(query);
      } else {
        showError('AI Search is not configured. Please contact support.');
      }
      return;
    }
    
    showLoading();
    
    try {
      const response = await fetch(WORKER_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          query: query,
          history: conversationHistory.slice(-6), // Last 3 exchanges
          stream: true
        })
      });
      
      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        
        // Handle specific error codes
        if (errorData.details && errorData.details[0]) {
          const errorCode = errorData.details[0].code;
          const errorMessage = errorData.details[0].message;
          
          if (errorCode === 10000 || errorMessage === 'Authentication error') {
            throw new Error('AI service temporarily unavailable. Please try again later.');
          }
        }
        
        throw new Error(errorData.error || 'Search failed. Please try again.');
      }
      
      // Handle streaming response
      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let fullResponse = '';
      let resultData = null;
      
      hideLoading();
      
      // Create answer container
      resultsEl.innerHTML = `
        <div class="ai-search-exchange">
          <div class="ai-search-user-message">
            <div class="ai-search-user-message-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              You asked
            </div>
            <div class="ai-search-user-message-content"><p>${escapeHtml(query)}</p></div>
          </div>
          <div class="ai-search-answer">
            <div class="ai-search-answer-header">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a10 10 0 1 0 10 10H12V2Z"></path>
                <path d="M12 12 2 12"></path>
              </svg>
              <h3>AI Response</h3>
            </div>
            <div class="ai-search-answer-content" id="ai-answer-content-${sectionId}"></div>
          </div>
        </div>
      `;
      
      const answerContent = document.getElementById('ai-answer-content-' + sectionId);
      
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        
        const chunk = decoder.decode(value, { stream: true });
        const lines = chunk.split('\n');
        
        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const data = line.slice(6);
            if (data === '[DONE]') continue;
            
            try {
              const parsed = JSON.parse(data);
              if (parsed.content) {
                fullResponse += parsed.content;
                answerContent.innerHTML = '<p>' + convertMarkdownToHtml(fullResponse) + '</p>';
              }
              if (parsed.result) {
                resultData = parsed.result;
              }
            } catch (e) {
              // Continue on parse errors
            }
          }
        }
      }
      
      // Add products if available
      if (resultData && resultData.products && resultData.products.length > 0) {
        displayProducts(resultData.products);
      }
      
      // Store in conversation history
      conversationHistory.push(
        { role: 'user', content: query },
        { role: 'assistant', content: fullResponse }
      );
      
    } catch (error) {
      console.error('AI Search Error:', error);
      
      // Retry logic
      if (retryCount < MAX_RETRIES && !error.message.includes('temporarily unavailable')) {
        setTimeout(() => performSearch(query, retryCount + 1), 1000 * (retryCount + 1));
        return;
      }
      
      showError(error.message || 'An error occurred. Please try again.');
    }
  }
  
  function displayProducts(products) {
    if (!products || products.length === 0) return;
    
    let html = `
      <div class="ai-search-products">
        <h4 class="ai-search-products-heading">Related Products</h4>
        <div class="ai-search-products-grid">
    `;
    
    products.forEach(product => {
      html += `
        <div class="ai-search-product-card">
          ${product.image ? `<img src="${product.image}" alt="${escapeHtml(product.title)}" class="ai-search-product-image" loading="lazy">` : ''}
          <div class="ai-search-product-info">
            <h5 class="ai-search-product-title">${escapeHtml(product.title)}</h5>
            ${product.price ? `<div class="ai-search-product-price">${product.price}</div>` : ''}
          </div>
          <div class="ai-search-product-actions">
            <a href="${product.url}" class="ai-search-product-view-btn">View Details</a>
          </div>
        </div>
      `;
    });
    
    html += '</div></div>';
    resultsEl.innerHTML += html;
  }
  
  // Event Listeners
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    performSearch(input.value);
  });
  
  exampleButtons.forEach(button => {
    button.addEventListener('click', function() {
      const query = this.dataset.query;
      input.value = query;
      performSearch(query);
    });
  });
  
})();
</script>

{% schema %}
{
  "name": "AI Search",
  "tag": "section",
  "class": "section-ai-search",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Serving the Metalworking Industry Since 1994."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "How can I assist you today?"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Ask me anything about oil skimmers..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Ask AI"
    },
    {
      "type": "header",
      "content": "AI Configuration"
    },
    {
      "type": "text",
      "id": "worker_url",
      "label": "Cloudflare Worker URL",
      "info": "The AI search API endpoint. Leave empty to use standard search."
    },
    {
      "type": "checkbox",
      "id": "fallback_to_search",
      "label": "Fall back to standard search on error",
      "default": true,
      "info": "When AI search fails, redirect to native Shopify search"
    },
    {
      "type": "header",
      "content": "Examples"
    },
    {
      "type": "checkbox",
      "id": "show_examples",
      "label": "Show example questions",
      "default": true
    },
    {
      "type": "text",
      "id": "examples_label",
      "label": "Examples label",
      "default": "Try asking:"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "options": [
        { "value": "gradient", "label": "Linear Gradient" },
        { "value": "radial", "label": "Radial Gradient" },
        { "value": "solid", "label": "Solid Color" }
      ],
      "default": "radial"
    },
    {
      "type": "color",
      "id": "bg_color_start",
      "label": "Background color (start)",
      "default": "#005b8c"
    },
    {
      "type": "color",
      "id": "bg_color_end",
      "label": "Background color (end)",
      "default": "#c5c4c4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#005b8c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "example",
      "name": "Example Question",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label"
        },
        {
          "type": "text",
          "id": "query",
          "label": "Search query"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AI Search",
      "blocks": [
        {
          "type": "example",
          "settings": {
            "label": "Best oil skimmer for CNC",
            "query": "What is the best oil skimmer for CNC machines?"
          }
        },
        {
          "type": "example",
          "settings": {
            "label": "Coolant maintenance tips",
            "query": "How do I maintain my coolant?"
          }
        },
        {
          "type": "example",
          "settings": {
            "label": "Belt vs tube skimmers",
            "query": "What's the difference between belt and tube skimmers?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
